<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ExtendExprorer</RootNamespace>
    <AssemblyName>ExtendExprorer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>

    <!-- ★ 版数の単一の出どころ（2026-09-23）。ここを直せば
           - exe のファイルバージョン（エクスプローラーのプロパティに出る）
           - インストーラーのバージョン（「アプリと機能」に出る）
         の両方が動く。CI が読んで ISCC へ渡し、**exe に焼かれた値と突き合わせる**
         （ずれたまま配ると、表示と中身が食い違う）。
         app.manifest の assemblyIdentity version は別物（side-by-side の識別子・
         利用者には見えない）なので、揃える必要は無い -->
    <Version>0.1.0</Version>
    <Company>kairamu061-dev</Company>
    <Product>ExtendExprorer</Product>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- comctl32 v6（現代的な見た目の ListView 等）と DPI 対応の宣言 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- メモリ要件（30MB 前後）のための構成。スパイクで 25.7MB / コミット 6.8MB を実測 -->
    <PublishAot>true</PublishAot>
    <!-- session の JSON はソース生成コンテキストのみ使用（誤ってリフレクション経路に載せない） -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- 【メモリの追加の絞りどころ・現時点では有効にしない】
         スパイクでは InvariantGlobalization / UseSystemResourceKeys / StackTraceSupport=false を
         付けて測ったが、本体では
           - InvariantGlobalization: 日付の書式やカルチャ依存の比較が変わる
           - StackTraceSupport=false: 障害調査が難しくなる
         という副作用がある。**まず正しく動くものを作って実測し、目標に届かなければ絞る**。
         第 1 段のメモリ実測でこの判断を行う。 -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ★ 型はほぼ internal なので、テストから見えるようにする（2026-09-29）。
       InternalsVisibleTo を足すだけで、公開範囲は広げない -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ExtendExprorer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
