<UserControl
    x:Class="ExtendExprorer.Views.FileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ExtendExprorer.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 列ヘッダ（ファイルバー・クリックでソート）。メニュー欄(#F0F0F0)より少し薄い灰色、下は実線で区切る -->
        <Grid Grid.Row="0" Padding="8,0,8,0"
              Background="#F7F7F7"
              BorderThickness="0,0,0,1"
              BorderBrush="#D0D0D0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="名前" Click="OnSortName"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,1,6,1" FontSize="12" Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="1" Content="更新日時" Click="OnSortModified"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,1,6,1" FontSize="12" Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="2" Content="種類" Click="OnSortType"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,1,6,1" FontSize="12" Background="Transparent" BorderThickness="0"/>
            <Button Grid.Column="3" Content="サイズ" Click="OnSortSize"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                    Padding="6,1,6,1" FontSize="12" Background="Transparent" BorderThickness="0"/>
        </Grid>

        <ListView x:Name="List" Grid.Row="1"
                  SelectionMode="Extended"
                  SelectionChanged="OnSelectionChanged"
                  KeyboardAcceleratorPlacementMode="Hidden"
                  Tapped="OnItemTapped"
                  DoubleTapped="OnItemDoubleTapped"
                  RightTapped="OnRightTapped"
                  CanDragItems="True"
                  DragItemsStarting="OnDragItemsStarting"
                  AllowDrop="True"
                  DragOver="OnListDragOver"
                  Drop="OnListDrop">
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyShortcut"/>
                <KeyboardAccelerator Modifiers="Control" Key="X" Invoked="OnCutShortcut"/>
                <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteShortcut"/>
                <KeyboardAccelerator Key="Delete" Invoked="OnDeleteShortcut"/>
            </ListView.KeyboardAccelerators>
            <!-- 選択行の色。WinUI 既定の淡いグレーではエクスプローラーに比べて薄すぎるため、
                 クラシックな青系の濃いめの色に置き換える（2026-07-25 ユーザ要望） -->
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#A6D3F3"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#93C9EF"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#82C0EB"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="#D8D8D8"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E5F1FB"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#CFE8FA"/>
                <!-- 選択時も文字色は据え置き（黒）。左端の選択インジケータはエクスプローラーには無いので隠す -->
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
            </ListView.Resources>
            <!-- 行の縦間隔・文字サイズはサンプルツール準拠（行 19px / 12px。2026-08-04 ユーザ要望）。
                 FontSize はここで与えることで、行の名前とリネーム編集ボックスの両方に効く -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="19"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,0,8,0"/>
                    <Setter Property="CornerRadius" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryViewModel">
                    <Grid Opacity="{x:Bind RowOpacity}"
                          AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                            <!-- シェルアイコン解決までは従来グリフを表示（shell-icons） -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                          Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"/>
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind NameTextVisibility, Mode=OneWay}"/>
                            <!-- インライン リネーム(選択済み項目への間を空けた2回目クリックで表示)。
                                 幅は SizeRenameBox で名前の長さに合わせる。
                                 見た目はサンプルツール準拠: 角丸・厚い下線・大きな最小高を撤去し、
                                 行の中に収まる 1px 枠の細い編集ボックスにする（2026-07-25 ユーザ要望）。
                                 文字サイズは隣の名前 TextBlock と揃える（2026-07-27 ユーザ要望）。
                                 TextBox の既定スタイルは FontSize を ControlContentThemeFontSize(14) で
                                 明示指定しており、行(ListViewItem)の 12 は継承されない。明示指定が必要 -->
                            <TextBox Text="{x:Bind Name}" Padding="2,0,2,0" FontSize="12"
                                     Height="17" MinHeight="0" MinWidth="0" CornerRadius="0"
                                     BorderThickness="1" VerticalContentAlignment="Center"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Visibility="{x:Bind RenameBoxVisibility, Mode=OneWay}"
                                     Loaded="OnRenameBoxLoaded"
                                     TextChanged="OnRenameBoxTextChanged"
                                     KeyDown="OnRenameBoxKeyDown"
                                     LostFocus="OnRenameBoxLostFocus">
                                <TextBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">0</x:Double>
                                    <x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
                                    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                                    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#7A7A7A"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#7A7A7A"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0078D4"/>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ModifiedLabel}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="ErrorText" Grid.Row="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

        <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False"
                      Width="32" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
