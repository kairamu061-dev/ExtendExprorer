<UserControl
    x:Class="ExtendExprorer.Views.PaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ExtendExprorer.Views"
    xmlns:vm="using:ExtendExprorer.ViewModels">
    <!-- 枠線はアクティブペインの強調表示(SetActive)で色が替わる -->
    <!-- 配色はサンプルツール準拠: タブ帯・ツールバー #F0F0F0 / 一覧は白 -->
    <Border x:Name="RootBorder" BorderThickness="1">
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タブバー(コンテンツはタブ下の共有領域に表示するため TabViewItem は空)。
                 WinUI 既定のタブは背が高すぎるので、サンプルツール相当までタブ帯を詰める
                 （帯 32px / タブ 28px。26/24 では日本語のタブ名とアイコンが下に見切れた・2026-07-27 報告） -->
            <TabView x:Name="Tabs" Grid.Row="0"
                     VerticalAlignment="Top"
                     Height="32"
                     Background="#F0F0F0"
                     IsAddTabButtonVisible="True"
                     CanReorderTabs="False"
                     CanDragTabs="False"
                     AddTabButtonClick="OnAddTabButtonClick"
                     TabCloseRequested="OnTabCloseRequested"
                     SelectionChanged="OnTabSelectionChanged">
                <TabView.Resources>
                    <x:Double x:Key="TabViewItemMinWidth">72</x:Double>
                    <x:Double x:Key="TabViewItemMaxWidth">180</x:Double>
                    <x:Double x:Key="TabViewItemHeaderFontSize">12</x:Double>
                    <x:Double x:Key="TabViewItemAddButtonWidth">24</x:Double>
                    <x:Double x:Key="TabViewItemAddButtonHeight">24</x:Double>
                    <Thickness x:Key="TabViewItemHeaderPadding">6,0,4,0</Thickness>
                    <Thickness x:Key="TabViewItemHeaderIconMargin">0,0,6,0</Thickness>
                    <Thickness x:Key="TabViewItemAddButtonMargin">0</Thickness>
                </TabView.Resources>
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:TabViewModel">
                        <TabViewItem IsClosable="True"
                                     Height="28" MinHeight="0" FontSize="12"
                                     Padding="6,0,4,0" CornerRadius="0">
                            <!-- アイコンは IconSource ではなく Header に直接置く。ImageIconSource は
                                 固有サイズを持たず TabViewItem 側も寸法を与えないため、測定が無限大に
                                 なって表示されなかった(BUG-011)。一覧・ツリーと同じ 16x16 の重ね方に揃える -->
                            <TabViewItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                                  Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"/>
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </TabViewItem.Header>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
            </TabView>

            <!-- ナビゲーションツールバー＋アドレスバー。タブ帯とファイルバーの間を実線で区切る -->
            <Border Grid.Row="1" Background="#F0F0F0"
                    BorderBrush="#D0D0D0" BorderThickness="0,1,0,1">
                <Grid Padding="8,4,8,4" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- ツールバーのアイコンは生成アイコン（Assets/*.png）。読み込みに失敗した場合に
                         ボタンが空にならないよう、背面に Segoe Fluent Icons のグリフを残している。
                         絵柄が円の下地の中に描かれているぶん小さく見えるので 20px で表示し、
                         ボタンの余白を詰めてツールバーの高さは変えない（2026-08-01 差し替え） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="BackButton" Click="OnBack" IsEnabled="False" ToolTipService.ToolTip="戻る"
                                AutomationProperties.Name="戻る" Padding="4,2,4,2" MinWidth="0" MinHeight="0">
                            <Grid>
                                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                                <Image Source="/Assets/nav-back.png" Width="20" Height="20"
                                       ImageFailed="OnIconFailed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="ForwardButton" Click="OnForward" IsEnabled="False" ToolTipService.ToolTip="進む"
                                AutomationProperties.Name="進む" Padding="4,2,4,2" MinWidth="0" MinHeight="0">
                            <Grid>
                                <FontIcon Glyph="&#xE72A;" FontSize="14"/>
                                <Image Source="/Assets/nav-forward.png" Width="20" Height="20"
                                       ImageFailed="OnIconFailed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="UpButton" Click="OnUp" IsEnabled="False" ToolTipService.ToolTip="上へ"
                                AutomationProperties.Name="上へ" Padding="4,2,4,2" MinWidth="0" MinHeight="0">
                            <Grid>
                                <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                                <Image Source="/Assets/nav-up.png" Width="20" Height="20"
                                       ImageFailed="OnIconFailed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <views:AddressBar x:Name="Address" Grid.Column="1" VerticalAlignment="Center"/>
                    <!-- 分割ボタンも戻る/進む/上へと同じアイコン表示にする（2026-07-27 ユーザ要望）。
                         生成アイコンの差し替え手順は tmp のアイコン生成プロンプト参照 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="SplitVButton" Click="OnSplitVertical"
                                ToolTipService.ToolTip="このペインを左右に分割（縦分割）"
                                AutomationProperties.Name="縦分割" Padding="4,2,4,2" MinWidth="0" MinHeight="0">
                            <Grid>
                                <FontIcon Glyph="&#xE90D;" FontSize="14"/>
                                <Image Source="/Assets/split-vertical.png" Width="20" Height="20"
                                       ImageFailed="OnIconFailed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="SplitHButton" Click="OnSplitHorizontal"
                                ToolTipService.ToolTip="このペインを上下に分割（横分割）"
                                AutomationProperties.Name="横分割" Padding="4,2,4,2" MinWidth="0" MinHeight="0">
                            <Grid>
                                <FontIcon Glyph="&#xE90E;" FontSize="14"/>
                                <Image Source="/Assets/split-horizontal.png" Width="20" Height="20"
                                       ImageFailed="OnIconFailed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- アクティブタブのファイル一覧(タブごとに使い回す共有ビュー) -->
            <views:FileListView x:Name="FileList" Grid.Row="2"/>
        </Grid>
    </Border>
</UserControl>
