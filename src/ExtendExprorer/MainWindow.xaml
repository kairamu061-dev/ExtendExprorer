<Window
    x:Class="ExtendExprorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ExtendExprorer.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 復元時に一部パスが見つからなかった場合の通知（10 秒で自動的に閉じる） -->
        <InfoBar x:Name="RestoreInfo" Grid.Row="0"
                 Severity="Warning" IsClosable="True"
                 Message="一部のフォルダが見つからなかったためホームで開きました"/>
        <!-- 左: フォルダツリー / 境界: ドラッグで幅調整 / 右: ペイン領域 -->
        <Grid x:Name="MainArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <views:FolderTreePanel x:Name="TreePanel" Grid.Column="0"/>
            <!-- 列 1 の境界バー(PanelSplitter)はコード側で生成して差し込む。
                 XAML から独自型を生成させると Native AOT で型情報の解決に失敗しうるため(BUG-013) -->
            <views:LayoutHost x:Name="Host" Grid.Column="2"/>
        </Grid>
    </Grid>
</Window>
