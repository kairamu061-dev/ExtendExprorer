<UserControl
    x:Class="ExtendExprorer.Views.FolderTreePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ExtendExprorer.ViewModels">
    <Grid x:Name="Root" Width="240"
          Background="White"
          BorderThickness="0,0,1,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="6,2,2,2" Background="#F0F0F0">
            <TextBlock x:Name="HeaderText" Text="フォルダー" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="ToggleButton" Click="OnToggle"
                    HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0" Padding="4"
                    AutomationProperties.Name="フォルダーツリーの折りたたみ">
                <FontIcon x:Name="ToggleIcon" Glyph="&#xE76B;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- アイコン・行の高さ・選択色は右のファイル一覧(FileListView)と同じ見え方に揃える
             （2026-07-25 ユーザ要望） -->
        <TreeView x:Name="Tree" Grid.Row="1"
                  SelectionMode="Single"
                  CanDragItems="False" CanReorderItems="False"
                  Expanding="OnExpanding"
                  ItemInvoked="OnItemInvoked">
            <TreeView.Resources>
                <!-- 行高は file-list の ListViewItem と同じく MinHeight で与える。
                     TreeViewItem は ContentControl で、テンプレート内に展開シェブロンと
                     ContentPresenter を持つ。Height を固定すると中身がその枠に押し込められ、
                     16px のアイコンと文字が 7px に潰れる（BUG-014）。上限は与えないこと -->
                <x:Double x:Key="TreeViewItemMinHeight">19</x:Double>
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#A6D3F3"/>
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#93C9EF"/>
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#82C0EB"/>
                <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#E5F1FB"/>
                <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#CFE8FA"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#A6D3F3"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#93C9EF"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#82C0EB"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E5F1FB"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#CFE8FA"/>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderNodeViewModel">
                    <TreeViewItem ItemsSource="{x:Bind Children}"
                                  HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                  Opacity="{x:Bind RowOpacity}"
                                  MinHeight="19" Padding="0" CornerRadius="0"
                                  FontSize="12" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="{x:Bind Name}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <!-- file-list と同じく、シェルアイコン解決までは従来グリフを表示する -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12"
                                          Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"/>
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
